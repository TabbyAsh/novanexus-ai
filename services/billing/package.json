{
  "name": "@nova/billing-service",
  "version": "0.1.0",
  "description": "Billing and subscription service for Nova platform with Stripe integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova/proof-core": "*",
    "@nova/shared": "*",
    "@nova/telemetry": "*",
    "express": "^4.18.2",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
