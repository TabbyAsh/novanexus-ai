{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nova/shared": ["../../libs/shared/src/index.ts"],
      "@nova/shared/*": ["../../libs/shared/src/*"],
      "@nova/telemetry": ["../../libs/telemetry/src/index.ts"],
      "@nova/telemetry/*": ["../../libs/telemetry/src/*"],
      "@nova/bot-sdk": ["../../libs/bot-sdk/src/index.ts"],
      "@nova/bot-sdk/*": ["../../libs/bot-sdk/src/*"],
      "@nova/eventing": ["../../libs/eventing/src/index.ts"],
      "@nova/eventing/*": ["../../libs/eventing/src/*"],
      "@nova/nexus-core": ["../../libs/nexus-core/src/index.ts"],
      "@nova/nexus-core/*": ["../../libs/nexus-core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
