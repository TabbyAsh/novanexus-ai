{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "../..",
    "paths": {
      "@nova/shared": ["libs/shared/src/index.ts"],
      "@nova/shared/*": ["libs/shared/src/*"],
      "@nova/telemetry": ["libs/telemetry/src/index.ts"],
      "@nova/telemetry/*": ["libs/telemetry/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
