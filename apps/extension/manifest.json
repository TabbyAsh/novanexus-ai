{
  "manifest_version": 3,
  "name": "Nova Lens — instant flip verdict",
  "version": "0.1.0",
  "description": "Open any eBay listing. Nova reads it, pulls real sold comps, and shows a verdict card: worth, fees, net profit, time to sell. No typing.",
  "permissions": [],
  "host_permissions": [
    "https://novanexus-ai.com/*",
    "https://abackend-production.up.railway.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nova Lens — open an eBay listing to get the verdict",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.ebay.com/itm/*", "https://ebay.com/itm/*"],
      "js": ["comps.js", "content.js"],
      "css": ["card.css"],
      "run_at": "document_idle"
    }
  ]
}
