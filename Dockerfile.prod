# Production Dockerfile for NovaNexus Backend
# Runs all backend services in a single container using PM2
#
# Build: docker build -f Dockerfile.prod -t nova-backend .
# Run:   docker run -p 3000:3000 --env-file .env nova-backend
# Cache bust: 2026-06-03-v2

FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files first for better caching
COPY package.json package-lock.json turbo.json ./

# Copy only backend workspaces (not apps/web)
COPY libs ./libs
COPY services ./services
COPY infra ./infra
COPY scripts ./scripts

# Copy tsconfig for esbuild
COPY tsconfig.json ./

# Install all dependencies (need devDeps for build)
ENV NODE_ENV=development
RUN npm ci --legacy-peer-deps --ignore-scripts

# Install esbuild globally
RUN npm install -g esbuild

# Build workspace libs with turbo (must succeed — these are deps for everything)
RUN npx turbo run build --filter=@nova/shared --filter=@nova/telemetry --filter=@nova/eventing --filter=@nova/bot-sdk --filter=@nova/nexus-core --no-cache

# ==========================================================================
# Bundle production services with esbuild
# Every service listed here is REQUIRED for production. If it fails, the
# build fails. That is intentional.
# Cache-bust token — increment this to force all esbuild layers to rebuild:
ENV NOVA_BUILD_TOKEN=2026-06-03-v3
# ==========================================================================

RUN esbuild services/gateway/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/gateway/dist/index.js \
  --external:pg-native \
  --tsconfig=services/gateway/tsconfig.json

RUN esbuild services/auth/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/auth/dist/index.js \
  --external:pg-native --external:bcryptjs \
  --tsconfig=services/auth/tsconfig.json

RUN esbuild services/orchestrator/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/orchestrator/dist/index.js \
  --external:pg-native \
  --tsconfig=services/orchestrator/tsconfig.json

RUN esbuild services/eventbus/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/eventbus/dist/index.js \
  --external:pg-native \
  --tsconfig=services/eventbus/tsconfig.json

RUN esbuild services/billing/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/billing/dist/index.js \
  --external:pg-native --external:stripe \
  --tsconfig=services/billing/tsconfig.json

RUN esbuild services/tradebot/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/tradebot/dist/index.js \
  --external:pg-native --external:openai --external:@nova/nexus-core \
  --tsconfig=services/tradebot/tsconfig.json

RUN esbuild services/marketdata/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/marketdata/dist/index.js \
  --external:pg-native \
  --tsconfig=services/marketdata/tsconfig.json

RUN esbuild services/nova-hub/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/nova-hub/dist/index.js \
  --external:pg-native --external:openai \
  --tsconfig=services/nova-hub/tsconfig.json

RUN esbuild services/socialbot/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/socialbot/dist/index.js \
  --external:pg-native --external:cors --external:openai \
  --tsconfig=services/socialbot/tsconfig.json

RUN esbuild services/storebot/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/storebot/dist/index.js \
  --external:pg-native --external:cors \
  --tsconfig=services/storebot/tsconfig.json

RUN esbuild services/commercedata/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/commercedata/dist/index.js \
  --external:pg-native \
  --tsconfig=services/commercedata/tsconfig.json

RUN esbuild services/scheduler/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/scheduler/dist/index.js \
  --external:pg-native \
  --tsconfig=services/scheduler/tsconfig.json

RUN esbuild services/opsbot/src/index.ts \
  --bundle --platform=node --target=node20 \
  --outfile=services/opsbot/dist/index.js \
  --external:pg-native \
  --tsconfig=services/opsbot/tsconfig.json

# Verify ALL production bundles exist — fail hard if any are missing
RUN echo '=== Verifying all production bundles ===' && \
  ls -la services/gateway/dist/index.js && \
  ls -la services/auth/dist/index.js && \
  ls -la services/orchestrator/dist/index.js && \
  ls -la services/eventbus/dist/index.js && \
  ls -la services/billing/dist/index.js && \
  ls -la services/tradebot/dist/index.js && \
  ls -la services/marketdata/dist/index.js && \
  ls -la services/nova-hub/dist/index.js && \
  ls -la services/socialbot/dist/index.js && \
  ls -la services/storebot/dist/index.js && \
  ls -la services/commercedata/dist/index.js && \
  ls -la services/scheduler/dist/index.js && \
  ls -la services/opsbot/dist/index.js && \
  echo '=== All production bundles verified ==='

# ─────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

# Install PM2 globally for process management
RUN npm install -g pm2

# Copy built artifacts
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/libs ./libs
COPY --from=builder /app/services ./services
COPY --from=builder /app/infra ./infra
COPY --from=builder /app/scripts ./scripts

# Copy PM2 ecosystem file
COPY ecosystem.config.js ./

ENV NODE_ENV=production
EXPOSE 3000

# Health check on gateway (uses PORT env if set by Railway)
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD wget --spider -q http://localhost:${PORT:-3000}/health || exit 1

# Create startup script that validates env, runs migrations, then starts PM2
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'echo "=== Validating Environment ==="' >> /app/start.sh && \
    echo 'node /app/scripts/validate-env.js' >> /app/start.sh && \
    echo 'echo "=== Running Migrations ==="' >> /app/start.sh && \
    echo 'node /app/scripts/run-migrations.js' >> /app/start.sh && \
    echo 'echo "=== Starting Services ==="' >> /app/start.sh && \
    echo 'exec pm2-runtime ecosystem.config.js' >> /app/start.sh && \
    chmod +x /app/start.sh

# Start with migrations then PM2
CMD ["/app/start.sh"]
