# ============================================
# Nova Enterprises - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Database
# ============================================
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_password
POSTGRES_DB=nova
DATABASE_URL=postgresql://nova:nova_dev_password@localhost:5432/nova

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# MinIO (S3-compatible object storage)
# ============================================
MINIO_ROOT_USER=nova_minio
MINIO_ROOT_PASSWORD=nova_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=nova-storage

# ============================================
# Authentication
# ============================================
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# API Keys (External Services)
# ============================================
# Stripe (Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Private-pilot checkout allowlist. Leave an unavailable plan/interval blank;
# the billing service will reject it instead of substituting another price.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_FLIP_PRO=

# Market Data Providers
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Alpaca Trading API (Paper or Live)
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Broker credential encryption (32+ random chars recommended)
BROKER_ENCRYPTION_KEY=

# Social Media APIs
YOUTUBE_API_KEY=
TIKTOK_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# AI/LLM Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Email (Notifications)
# ============================================
RESEND_API_KEY=
SERVICE_INQUIRY_OPERATOR_EMAIL=hello@novanexus-ai.com
SERVICE_INQUIRY_SEND_CONFIRMATION=true
# Shared by gateway and billing. Generate 32 random bytes as base64url; do not
# use a repeated-character placeholder or commit the real value.
SERVICE_PAYMENT_RESOLVER_TOKEN=
# Keep reconciliation enabled in production unless an incident runbook says otherwise.
SERVICE_PAYMENT_RECONCILIATION_DISABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nova-enterprises.com

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# Kill Switch (Global automation disable)
KILL_SWITCH_ENABLED=false

# ============================================
# Service URLs (for inter-service communication)
# ============================================
GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
ORCHESTRATOR_URL=http://localhost:3002
EVENTBUS_URL=http://localhost:3003
AUDIT_URL=http://localhost:3004
NOTIFIER_URL=http://localhost:3005
BILLING_URL=http://localhost:3006
NOVA_HUB_URL=http://localhost:3030

TRADEBOT_URL=http://localhost:3010
STOREBOT_URL=http://localhost:3011
SOCIALBOT_URL=http://localhost:3012
RESEARCHBOT_URL=http://localhost:3013
OPSBOT_URL=http://localhost:3014
FORGEBOT_URL=http://localhost:3015
CMDX_URL=http://localhost:3017

# ============================================
# Nova Forge (builder-agent layer)
# ============================================
# Master switch for the Forge subsystem (Phase 0: rails only)
FORGE_ENABLED=false
# Git remote agents clone in sandboxes (never the host checkout)
FORGE_GIT_REMOTE=
# Broker-side only; NEVER resolved into sandbox env (see sandbox allowlist)
FORGE_GIT_TOKEN=
# Org UUID used for Forge event chains (defaults to the zero UUID)
FORGE_ORG_ID=
# Budgets (hard stops)
FORGE_DAILY_TOKEN_BUDGET=2000000
FORGE_TASK_TOKEN_BUDGET=250000

# CmdX command broker (port 3017)
# Execution stays OFF until the sandbox driver ships (Phase 2)
CMDX_EXECUTION_ENABLED=false
CMDX_REQUIRE_AUTH=true
CMDX_DEFAULT_MODE=ASSIST
CMDX_KILLSWITCH_TTL_MS=5000
CMDX_MAX_COMMANDS_PER_RUN=200
CMDX_MAX_COMMANDS_PER_MINUTE=20
CMDX_CIRCUIT_BREAKER_THRESHOLD=5
# Sandbox-visible resources (the ONLY env vars that can enter a sandbox,
# per nova.constraints.yaml sandbox_env_allowlist)
SANDBOX_DATABASE_URL=
SANDBOX_REDIS_URL=
# Egress allowlist enforced by the sandbox proxy sidecar (Phase 2+)
EGRESS_PROXY_ALLOWLIST=registry.npmjs.org,github.com,codeload.github.com

MARKETDATA_URL=http://localhost:3020
CONTENTDATA_URL=http://localhost:3021
COMMERCEDATA_URL=http://localhost:3022

# ============================================
# Web (Next.js) - client-exposed service URLs
# IMPORTANT: Only variables prefixed with NEXT_PUBLIC_ are accessible in the browser.
# ============================================
# Required for deployed web environments. Production should point to production;
# previews should point to staging or remain unset so they fail closed with 503.
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional Stripe-hosted one-time payment link. It is shown only after the
# complete pilot intake receives a durable receipt.
NEXT_PUBLIC_BACK_OFFICE_STARTER_PAYMENT_URL=

# ============================================
# Feature Flags
# ============================================
FEATURE_PAPER_TRADING=true
FEATURE_LIVE_TRADING=false
FEATURE_AUTO_POSTING=false
FEATURE_AUTO_FORGE=false

# ============================================
# Internal Verification (Phase 0)
# ============================================
INTERNAL_VERIFY_ENABLED=false
INTERNAL_VERIFY_TOKEN=
INTERNAL_DECISION_CARDS_TOKEN=
INTERNAL_VERIFY_USER_ID=
INTERNAL_VERIFY_SYMBOL=SPY
INTERNAL_VERIFY_DAYS=10
INTERNAL_VERIFY_PLAN=
INTERNAL_VERIFY_ALPACA_KEY=
INTERNAL_VERIFY_ALPACA_SECRET=
INTERNAL_VERIFY_ALPACA_ENDPOINT=
# Comma-separated emails allowed to receive platform-wide Forge, Ops, and
# Admin scopes. Organization OWNER role is tenant-local and never sufficient.
PLATFORM_OWNER_EMAILS=
# Keep false on public deployments. The local launcher sets true so the
# configured founder can claim the initial account from the same machine.
ALLOW_UNVERIFIED_FOUNDER_REGISTRATION=false
CODEX_SPECIALIST_ENABLED=false
CODEX_WORKSPACE_ROOT=
