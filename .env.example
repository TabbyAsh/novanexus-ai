# ============================================
# Nova Enterprises - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Database
# ============================================
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_password
POSTGRES_DB=nova
DATABASE_URL=postgresql://nova:nova_dev_password@localhost:5432/nova

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# MinIO (S3-compatible object storage)
# ============================================
MINIO_ROOT_USER=nova_minio
MINIO_ROOT_PASSWORD=nova_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=nova-storage

# ============================================
# Authentication
# ============================================
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# API Keys (External Services)
# ============================================
# Stripe (Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Market Data Providers
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Alpaca Trading API (Paper or Live)
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Social Media APIs
YOUTUBE_API_KEY=
TIKTOK_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# AI/LLM Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Email (Notifications)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nova-enterprises.com

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# Kill Switch (Global automation disable)
KILL_SWITCH_ENABLED=false

# ============================================
# Service URLs (for inter-service communication)
# ============================================
GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
ORCHESTRATOR_URL=http://localhost:3002
EVENTBUS_URL=http://localhost:3003
AUDIT_URL=http://localhost:3004
NOTIFIER_URL=http://localhost:3005
BILLING_URL=http://localhost:3006

TRADEBOT_URL=http://localhost:3010
STOREBOT_URL=http://localhost:3011
SOCIALBOT_URL=http://localhost:3012
RESEARCHBOT_URL=http://localhost:3013
OPSBOT_URL=http://localhost:3014
FORGEBOT_URL=http://localhost:3015

MARKETDATA_URL=http://localhost:3020
CONTENTDATA_URL=http://localhost:3021
COMMERCEDATA_URL=http://localhost:3022

# ============================================
# Web (Next.js) - client-exposed service URLs
# IMPORTANT: Only variables prefixed with NEXT_PUBLIC_ are accessible in the browser.
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Feature Flags
# ============================================
FEATURE_PAPER_TRADING=true
FEATURE_LIVE_TRADING=false
FEATURE_AUTO_POSTING=false
FEATURE_AUTO_FORGE=false
