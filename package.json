{
  "name": "nova-enterprises",
  "version": "0.1.0",
  "private": true,
  "description": "AI-orchestrated universal life-and-business operating system",
  "workspaces": [
    "apps/*",
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "node scripts/nova-mvp.js",
    "dev:nodocker": "node scripts/nova-mvp.js --no-docker",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "psql $DATABASE_URL -f infra/migrations/001_initial_schema.sql && psql $DATABASE_URL -f infra/migrations/002_bots_table.sql",
    "db:seed": "node scripts/db-seed.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "nova:up": "docker-compose -f docker-compose.mvp.yml up --build -d",
    "nova:down": "docker-compose -f docker-compose.mvp.yml down",
    "nova:smoke": "node scripts/smoke-test.js --mvp",
    "nova:smoke:all": "node scripts/smoke-test.js",
    "nova:smoke:wait": "node scripts/smoke-test.js --mvp --wait",
    "stack:ready": "node scripts/stack-ready.js --mvp",
    "stack:ready:all": "node scripts/stack-ready.js",
    "nova:mvp": "node scripts/nova-mvp.js",
    "verify": "node scripts/verify.js",
    "nova:mvp:up": "docker-compose -f docker-compose.mvp.yml up --build",
    "nova:mvp:down": "docker-compose -f docker-compose.mvp.yml down -v",
    "nova:mvp:logs": "docker-compose -f docker-compose.mvp.yml logs -f",
    "verify:prod": "node scripts/verify-prod.js",
    "deploy:prod": "node scripts/deploy-prod.js",
    "deploy:web": "node scripts/deploy-web.js",
    "deploy:all": "node scripts/deploy-prod.js && node scripts/deploy-web.js",
    "seed:prod": "node scripts/seed-prod.js",
    "deploy:railway": "node scripts/deploy-railway.js",
    "db:migrate:prod": "railway run node scripts/run-migrations.js",
    "validate:env": "node scripts/validate-env.js",
    "prod:start": "node scripts/prod-start.js",
    "docker:build:prod": "docker build -f Dockerfile.prod -t nova-backend ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^8.55.0",
    "jest": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.6",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.2.0",
  "dependencies": {
    "nova-enterprises": "file:"
  }
}
