{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/api/cron/purge", "schedule": "0 12 * * *" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/owner", "destination": "/api/owner/queue" },
    { "source": "/api/owner/export.csv", "destination": "/api/owner/export" }
  ],
  "redirects": [
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/contact", "destination": "/#quote", "permanent": true },
    { "source": "/catalog/:path*", "destination": "/#products", "permanent": true },
    { "source": "/products/:path*", "destination": "/#products", "permanent": true },
    { "source": "/services/:path*", "destination": "/#research", "permanent": true },
    { "source": "/pricing", "destination": "/#quote", "permanent": true },
    { "source": "/register", "destination": "/#quote", "permanent": true },
    { "source": "/tools/:path*", "destination": "/", "permanent": true }
  ]
}
