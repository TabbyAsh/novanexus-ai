# ============================================
# Nova Enterprises - Git Ignore
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment files (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Docker
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp

# Secrets and credentials
*.pem
*.key
*.crt
secrets/
credentials/

# Database files
*.sqlite
*.sqlite3
*.db

# MinIO local data (if running outside Docker)
minio-data/

# Python (if any Python services)
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.eggs/
*.egg-info/
*.egg
venv/
ENV/
.venv/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Misc
*.bak
*.backup
.cache/
.parcel-cache/

# Package manager locks (keep one, ignore others based on your choice)
# Uncomment the ones you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Test fixtures and mocks that shouldn't be committed
*.fixture.local.*
*.mock.local.*

# Local configuration overrides
*.local.json
*.local.yaml
*.local.yml
.vercel
